{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "DualGPU Project"
  ],
  "contact": {
    "homepage": "https://github.com/dualgpu/dualgpu-minecraft",
    "sources": "https://github.com/dualgpu/dualgpu-minecraft"
  },
  "license": "MIT",
  "icon": "assets/dualgpu/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.dualgpu.minecraft.DualGPUClientMod"
    ],
    "main": [
      "com.dualgpu.minecraft.DualGPUModInitializer"
    ]
  },
  "mixins": [
    "dualgpu.mixins.json"
  ],
  "accessWidener": "dualgpu.accesswidener",
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~1.21.4",
    "java": ">=21",
    "fabric-api": "*"
  },
  "suggests": {
    "iris": "*",
    "sodium": "*"
  },
  "custom": {
    "dualgpu": {
      "renderer_version": "0.1.0-m1",
      "milestone": 1,
      "compatibility_level": 0,
      "vulkan_required": true,
      "min_vulkan_version": "1.3.0"
    }
  }
}
